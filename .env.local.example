# Cholesterol Food Tracker — environment template.
# Copy to `.env.local` (git-ignored) and fill in. Restart `npm run dev` after editing.
#
# Only VITE_-prefixed values ever reach the browser. Everything else is server-only
# and is read by the handlers under api/ via lib/server/*.
#
# Every server key below must also be listed in SERVER_ENV_KEYS in tools/devApiPlugin.ts,
# or the dev server will not pass it through to the handlers.

# ─── Browser (public) ────────────────────────────────────────────────────────
# The Google OAuth *client ID* is public by design; it is not a secret.
VITE_GOOGLE_CLIENT_ID=

# ─── AI (the only paid service) ──────────────────────────────────────────────
# AI_PROVIDER selects the implementation in lib/ai/providers/.
#   openai    → needs OPENAI_API_KEY
#   anthropic → needs ANTHROPIC_API_KEY
#   mock      → deterministic, no network, no cost. For tests; not for real use.
AI_PROVIDER=anthropic
# Anthropic: claude-sonnet-5 (the default) | claude-opus-5 (most capable) | claude-haiku-4-5
# OpenAI:    gpt-5.6-luna (cheap, multimodal; the default) | any current multimodal id
AI_MODEL=claude-sonnet-5
# Reasoning depth, and the main latency lever: low | medium | high | xhigh | max,
# plus `none` on OpenAI only. Measured on this rubric with Claude: high (the API
# default) ~17s, medium ~11s, low ~6s per uncached analysis. Default is `low` on
# Anthropic and `none` on OpenAI, because quality did not visibly suffer -- the
# rubric is mechanical accumulation, not open-ended reasoning. A repeat is a cache
# hit at ~0.1s regardless. Neither provider sends `temperature: 0` any more --
# on gpt-5.x it is legal only at effort `none`, and reasoning is worth more to
# scoring quality than a fixed temperature is to stability.
AI_EFFORT=low
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Database ────────────────────────────────────────────────────────────────
# Neon Postgres connection string. Leave EMPTY in local development and an
# in-process Postgres (PGlite, persisted to .dev-data/) is used instead, with
# db/migrations/ applied automatically. Required in any deployed environment.
DATABASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Must match VITE_GOOGLE_CLIENT_ID. Token verification FAILS CLOSED without it:
# google-auth-library skips audience checking when no audience is supplied, which
# would accept tokens minted for any Google OAuth client.
GOOGLE_CLIENT_ID=
# Signing key for the session cookie. Generate: openssl rand -base64 48
SESSION_SECRET=

# Owner bootstrap and the fallback when the database is unreachable.
# Comma-separated. The live source of truth is the `allowlist` table.
ALLOWED_EMAILS=
# Administrators are defined HERE and never authoritatively in the database, so
# the admin UI cannot grant admin to anyone — including itself. Comma-separated.
ADMIN_EMAILS=

# ─── Local debug mode (functional spec §2.1) ─────────────────────────────────
# Skips Google login and starts a session as a fixed local debug user.
# Requires ALL THREE: DEBUG_AUTH=true, NODE_ENV!=production, and no VERCEL env var.
# A deployed build therefore cannot enable it regardless of what is set here.
DEBUG_AUTH=false
DEBUG_ADMIN=false

# ─── Cost control ────────────────────────────────────────────────────────────
# Durable per-user daily cap on model calls (ai_usage table).
AI_DAILY_CALL_LIMIT=100

# ─── Tests ───────────────────────────────────────────────────────────────────
# The ~30 fixed-description fixture suite calls the real model, so it is opt-in.
# Set to 1 and provide a key to run it: it is the regression net after a prompt edit.
RUN_AI_FIXTURES=0
